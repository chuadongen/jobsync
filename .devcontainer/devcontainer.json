{
  "name": "JobSync",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "containerEnv": { "TZ": "Asia/Singapore" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": { "app": "npm run dev" },
  "forwardPorts": [3737],
  "portsAttributes": {
    "3737": { "label": "JobSync", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
