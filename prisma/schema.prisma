// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Step: 1 run `npx prisma generate` 
// Step: 2 run `npx prisma migrate dev` after update, make sure code is updated afterwards

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(uuid())
  name              String
  email             String              @unique
  password          String
  createdAt         DateTime            @default(now())
  jobsApplied       Job[]
  JobTitle          JobTitle[]
  Location          Location[]
  Company           Company[]
  JobSource         JobSource[]
  Contact           Contact[]
  ContactRole       ContactRole[]
  JobStageType      JobStageType[]
  Task              Task[]
  Settings          UserSettings?
  Note              Note[]
  Tag               Tag[]
  McpAccessToken    McpAccessToken[]
  ResumeHeader      ResumeHeader?
  BankEntry         BankEntry[]
  BankSuggestion    BankSuggestion[]
  ResumeDoc         ResumeDoc[]
  CoverLetter       CoverLetter[]
  Document          Document[]
  AvailabilityBlock AvailabilityBlock[]
  Target            Target[]
  JobAnalysis       JobAnalysis[]
  GapReport         GapReport[]
}

model UserSettings {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  settings  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id          String  @id @default(uuid())
  name        String
  title       String?
  email       String?
  phone       String?
  linkedinUrl String?

  // Where they work now
  companyId  String?
  Company    Company?  @relation("ContactCompany", fields: [companyId], references: [id])
  locationId String?
  Location   Location? @relation(fields: [locationId], references: [id])

  // Shared history — how you know them
  relationship      String?
  workedAtCompanyId String?
  WorkedAtCompany   Company?  @relation("ContactWorkedAt", fields: [workedAtCompanyId], references: [id])
  workedFrom        DateTime?
  workedTo          DateTime?

  // What this person generally is to you. The per-job role on JobContact wins
  // for a specific job; this is the standing answer and the Phase 5 prefill.
  roleId String?
  Role   ContactRole? @relation(fields: [roleId], references: [id])

  notes           String?
  lastContactedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String // userId
  user      User     @relation(fields: [createdBy], references: [id])

  jobLinks   JobContact[]
  stageLinks JobStageInterviewer[]

  @@index([createdBy])
  @@index([companyId])
  @@index([workedAtCompanyId])
  @@index([roleId])
}

model ContactRole {
  id          String       @id @default(uuid())
  label       String
  value       String
  createdBy   String // userId
  user        User         @relation(fields: [createdBy], references: [id])
  jobContacts JobContact[]
  contacts    Contact[]

  @@unique([value, createdBy])
}

model JobContact {
  id        String      @id @default(uuid())
  jobId     String
  Job       Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  contactId String
  Contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  roleId    String
  Role      ContactRole @relation(fields: [roleId], references: [id])
  createdAt DateTime    @default(now())

  @@unique([jobId, contactId, roleId])
  @@index([contactId])
}

model JobTitle {
  id        String @id @default(uuid())
  label     String
  value     String
  jobs      Job[]
  createdBy String // userId
  user      User   @relation(fields: [createdBy], references: [id])

  @@unique([value, createdBy])
}

model JobStatus {
  id         String         @id @default(uuid())
  label      String
  value      String         @unique
  jobs       Job[]
  stageTypes JobStageType[]
}

model Location {
  id          String    @id @default(uuid())
  label       String
  value       String
  stateProv   String?
  country     String?
  jobsApplied Job[]
  createdBy   String // userId
  user        User      @relation(fields: [createdBy], references: [id])
  contacts    Contact[]

  @@unique([value, createdBy])
}

model Company {
  id          String  @id @default(uuid())
  label       String
  value       String
  jobsApplied Job[]
  logoUrl     String? // field is optional
  createdBy   String // userId
  user        User    @relation(fields: [createdBy], references: [id])

  contacts         Contact[] @relation("ContactCompany")
  formerColleagues Contact[] @relation("ContactWorkedAt")

  // Watch intent: companies you are targeting
  watched   Boolean   @default(false)
  watchedAt DateTime?

  websiteUrl  String?
  careersUrl  String?
  industry    String?
  linkedinUrl String?
  size        String?
  notes       String?

  @@unique([value, createdBy])
  @@index([createdBy, watched])
}

model JobSource {
  id          String @id @default(uuid())
  label       String
  value       String
  jobsApplied Job[]
  createdBy   String // userId
  user        User   @relation(fields: [createdBy], references: [id])

  @@unique([value, createdBy])
}

// The kind of stage. Mirrors ContactRole in ownership and resolution, and
// JobSource in being user-extensible. statusId is both the derived-status
// source and the interview-kind discriminator (spec decisions 3 and 10).
model JobStageType {
  id        String     @id @default(uuid())
  label     String
  value     String
  statusId  String
  Status    JobStatus  @relation(fields: [statusId], references: [id])
  sortOrder Int        @default(0)
  createdBy String // userId
  user      User       @relation(fields: [createdBy], references: [id])
  stages    JobStage[]

  @@unique([value, createdBy])
  @@index([createdBy])
}

// One entry in a job's timeline. No ownership column: a stage has no meaning
// apart from its job, so ownership traverses Job: { userId }.
model JobStage {
  id           String                @id @default(uuid())
  jobId        String
  Job          Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stageTypeId  String
  StageType    JobStageType          @relation(fields: [stageTypeId], references: [id])
  occurredAt   DateTime?
  isCurrent    Boolean               @default(false)
  outcome      String?
  notes        String?
  // Written with Claude: preparation before the round, and what actually
  // happened after it. The user's own notes stay in `notes`.
  prepNotes    String?
  debrief      String?
  durationMins Int?
  format       String?
  location     String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  interviewers JobStageInterviewer[]
  // Also has a hand-written partial unique index (not expressible here):
  // UNIQUE(jobId) WHERE isCurrent = 1
  // See migrations/20261020000000_init

  @@index([jobId])
  @@index([stageTypeId])
}

model JobStageInterviewer {
  id        String   @id @default(uuid())
  stageId   String
  Stage     JobStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contactId String
  Contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([stageId, contactId])
  @@index([contactId])
}

model Job {
  id            String        @id @default(uuid())
  userId        String
  User          User          @relation(fields: [userId], references: [id])
  jobUrl        String?
  description   String
  jobType       String
  workplaceType String?
  createdAt     DateTime
  applied       Boolean       @default(false)
  appliedDate   DateTime?
  dueDate       DateTime?
  statusId      String
  Status        JobStatus     @relation(fields: [statusId], references: [id])
  JobTitle      JobTitle      @relation(fields: [jobTitleId], references: [id])
  jobTitleId    String
  Company       Company       @relation(fields: [companyId], references: [id])
  companyId     String
  JobSource     JobSource?    @relation(fields: [jobSourceId], references: [id])
  jobSourceId   String?
  salaryRange   String?
  Location      Location?     @relation(fields: [locationId], references: [id])
  locationId    String?
  // Internship or role period, used for clash checks against availability blocks
  startDate     DateTime?
  endDate       DateTime?
  Notes         Note[]
  tags          Tag[]
  contactLinks  JobContact[]
  stages        JobStage[]
  resumeDocs    ResumeDoc[]
  coverLetters  CoverLetter[]
  documents     Document[]
  analysis      JobAnalysis?

  // MCP provenance: which agent/token created this job (null = UI)
  createdVia              String?
  // Word-count classification of `description` at write time:
  // "title-only" | "partial" | "full". Null for pre-existing/UI jobs.
  descriptionCompleteness String?

  @@index([userId])
}

model Task {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  title           String
  description     String?
  status          String    @default("in-progress")
  priority        Int       @default(5)
  percentComplete Int       @default(0)
  dueDate         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
}

model Note {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([userId])
}

model Tag {
  id        String @id @default(uuid())
  label     String
  value     String
  createdBy String
  user      User   @relation(fields: [createdBy], references: [id])
  jobs      Job[]

  @@unique([value, createdBy])
}

model McpAccessToken {
  id          String    @id @default(uuid())
  userId      String
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  scopes      String // JSON array string; new tokens are always ["jobs:write","resume:write"]
  expiresAt   DateTime
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, name])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Resume crafting
//
// BankEntry/BankBullet is the master record of everything the user has done.
// A ResumeDoc is either a base version (PM, SWE, ...) or a variant tailored to
// one job from a base. Every bullet on a doc points back at the bank bullet it
// was written from, so no claim on a resume exists without a source.
// ---------------------------------------------------------------------------

// The contact block printed at the top of every resume
model ResumeHeader {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  location  String?
  email     String?
  phone     String?
  // JSON array of { label, url }
  links     String   @default("[]")
  updatedAt DateTime @updatedAt
}

model BankEntry {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // BankEntryType in bank.model.ts
  type         String
  // Organisation, school, project or award name; the label for a skills line
  organisation String
  // Role, degree or award placing
  title        String?
  location     String?
  // Free text as printed, e.g. "Aug 2025"; startSort orders entries
  startDate    String?
  endDate      String?
  startSort    DateTime?
  url          String?
  // Extra lines printed under the title (GPA, coursework) or a skills line
  details      String?
  // Private context for Claude and the user, never printed
  notes        String?
  // Comma-separated
  tags         String           @default("")
  sortOrder    Int              @default(0)
  archived     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  bullets      BankBullet[]
  docItems     ResumeItem[]
  suggestions  BankSuggestion[]

  @@index([userId, type])
}

model BankBullet {
  id         String         @id @default(uuid())
  entryId    String
  entry      BankEntry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  text       String
  // Comma-separated
  tags       String         @default("")
  sortOrder  Int            @default(0)
  archived   Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  docBullets ResumeBullet[]

  @@index([entryId])
}

// Additions Claude proposes. Nothing reaches the bank until the user accepts.
model BankSuggestion {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Set for a new bullet on an existing entry, null for a new entry
  entryId    String?
  entry      BankEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)
  // JSON, shape per kind in bank.model.ts
  payload    String
  rationale  String?
  // "pending" | "accepted" | "rejected"
  status     String     @default("pending")
  createdVia String?
  createdAt  DateTime   @default(now())
  decidedAt  DateTime?

  @@index([userId, status])
}

model ResumeDoc {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "base" | "variant"
  kind         String
  name         String
  // Variant only: the base it was derived from and the job it targets
  baseId       String?
  base         ResumeDoc?    @relation("BaseVariants", fields: [baseId], references: [id], onDelete: SetNull)
  variants     ResumeDoc[]   @relation("BaseVariants")
  jobId        String?
  job          Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  // Base only: the kind of role it targets, guidance for Claude
  targetRole   String?
  // JSON array of section keys in print order
  sectionOrder String
  // Why Claude chose what it chose, shown during review
  rationale    String?
  // "draft" | "approved" | "submitted"; only approved or submitted docs export
  status       String        @default("draft")
  approvedAt   DateTime?
  submittedAt  DateTime?
  // JSON of the rendered content, frozen on submit
  snapshot     String?
  // PDF written on submit, relative to the data directory
  pdfPath      String?
  createdVia   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  items        ResumeItem[]
  // Base only: job analyses mapped to it, and Claude's latest gap report
  analyses     JobAnalysis[]
  gapReport    GapReport?

  @@index([userId, kind])
  @@index([jobId])
}

// One bank entry placed on a doc
model ResumeItem {
  id              String         @id @default(uuid())
  docId           String
  doc             ResumeDoc      @relation(fields: [docId], references: [id], onDelete: Cascade)
  entryId         String
  entry           BankEntry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  sortOrder       Int            @default(0)
  // Overrides for the printed title and details lines
  titleOverride   String?
  detailsOverride String?
  bullets         ResumeBullet[]

  @@unique([docId, entryId])
  @@index([entryId])
}

model ResumeBullet {
  id        String     @id @default(uuid())
  itemId    String
  item      ResumeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sourceId  String
  source    BankBullet @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  // The printed wording; may be reworded from the source
  text      String
  sortOrder Int        @default(0)

  @@index([itemId])
  @@index([sourceId])
}

model CoverLetter {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId       String?
  job         Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  title       String
  // Markdown
  content     String
  // "draft" | "approved" | "submitted"
  status      String    @default("draft")
  approvedAt  DateTime?
  submittedAt DateTime?
  pdfPath     String?
  createdVia  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([jobId])
}

// A file in the vault. filePath is relative to the data directory.
model Document {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  // DocumentCategory in document.model.ts
  category   String
  fileName   String
  filePath   String   @unique
  mimeType   String
  sizeBytes  Int
  jobId      String?
  job        Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  notes      String?
  uploadedAt DateTime @default(now())

  @@index([userId, category])
  @@index([jobId])
}

// Exchange, trips and other periods to check internship dates against
model AvailabilityBlock {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  // "potential" | "absolute"
  kind      String
  startDate DateTime
  endDate   DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startDate])
}

// A company or kind of role the user means to apply to, whether or not a
// posting exists yet. Jobs match it by company name and/or a title keyword.
model Target {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  company    String?
  keyword    String?
  notes      String?
  archived   Boolean        @default(false)
  createdVia String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  windows    TargetWindow[]

  @@index([userId])
}

// When applications for one intake open and close. Claude's research lands
// as "suggested" and only counts once the user confirms it.
model TargetWindow {
  id         String    @id @default(uuid())
  targetId   String
  target     Target    @relation(fields: [targetId], references: [id], onDelete: Cascade)
  intake     String
  opensAt    DateTime
  closesAt   DateTime?
  roleStart  DateTime?
  roleEnd    DateTime?
  // Inferred from earlier years rather than announced for this intake
  estimated  Boolean   @default(false)
  // "suggested" | "confirmed"
  status     String    @default("confirmed")
  source     String?
  checkedAt  DateTime  @default(now())
  createdVia String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([targetId])
}

// What a job asks for, extracted by Claude while tailoring, with its read of
// how well the bank covers each requirement. Feeds the gaps view on bases.
model JobAnalysis {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId        String     @unique
  job          Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  baseId       String?
  base         ResumeDoc? @relation(fields: [baseId], references: [id], onDelete: SetNull)
  // JSON array of { label, kind, importance, coverage, evidence }
  requirements String
  createdVia   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId, baseId])
}

// Claude's written review of one base version's gaps.
model GapReport {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseId      String    @unique
  base        ResumeDoc @relation(fields: [baseId], references: [id], onDelete: Cascade)
  summary     String
  // JSON array of { title, detail, evidence }
  suggestions String
  createdVia  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}
