# Copy to .env and adjust.

# SQLite database. In Docker this points into the mounted data volume.
DATABASE_URL=file:./dev.db

# Where uploaded documents and sent PDFs are written. Relative paths resolve
# from the app's working directory. Defaults to ./data in development and
# /data in production.
# DATA_DIR=./data

# Interview times and "today" on the dashboard follow this.
TZ=Asia/Singapore

# The address you open JobSync at. Review links Claude gives you are built
# from it, e.g. http://192.168.1.20:3737 or https://jobs.example.ts.net
NEXTAUTH_URL=http://localhost:3737

# Required when the app is not served from localhost (LAN IP, reverse proxy).
AUTH_TRUST_HOST=true

# Generated by docker-entrypoint.sh when unset. To set it yourself:
#   openssl rand -base64 32
# AUTH_SECRET=

# The MCP endpoint Claude connects to. On by default in development, off in
# production unless set.
MCP_ENABLED=true

# Optional tracing to a self-hosted OpenTelemetry collector. Leave unset for none.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://homelab:5080/api/default
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic base64(email:token)
# OTEL_SERVICE_NAME=jobsync
