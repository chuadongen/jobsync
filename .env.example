# Copy to .env and adjust. Used by `npm run dev` locally and by
# docker-compose.yml on the server.

# --- Server (docker compose) ---------------------------------------------

# The HTTPS address you open JobSync at, e.g. from `tailscale serve`:
#   https://myserver.tail1234.ts.net:8443
# It is built into the image, so rebuild (./deploy.sh) after changing it.
NEXTAUTH_URL=http://localhost:3737

# Port on 127.0.0.1 the container listens on. Change it if 3737 is taken.
JOBSYNC_PORT=3737

# Where the database, documents and sent PDFs live on the host.
JOBSYNC_DATA=./jobsync-data

# Lets scripts/backup.sh fetch backups without logging in. Generate with:
#   openssl rand -hex 32
BACKUP_TOKEN=

TZ=Asia/Singapore

# Optional. Generated and kept in the data folder when left empty.
# AUTH_SECRET=

# --- Local development only ----------------------------------------------

DATABASE_URL=file:./dev.db
AUTH_TRUST_HOST=true
MCP_ENABLED=true
# DATA_DIR=./data

# Optional tracing to a self-hosted OpenTelemetry collector. Leave unset for none.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://homelab:5080/api/default
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic base64(email:token)
# OTEL_SERVICE_NAME=jobsync
